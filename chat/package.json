{
  "name": "@hcodex/chat",
  "version": "0.1.0",
  "private": true,
  "description": "hcodex chat SDK: multi-user conversations, send rules and routing for Codex app-server",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./input": {
      "types": "./dist/input.d.ts",
      "default": "./dist/input.js"
    }
  },
  "files": [
    "dist",
    "sql"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test --test-concurrency=1 test/*.test.ts",
    "prepack": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "pg": "^8.16.3",
    "ws": "^8.22.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/ws": "^8.18.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
